# API/webapp service. Every input below is runtime only.
DATABASE_URL="replace-with-postgresql-connection-string"
BETTER_AUTH_URL="https://replace-with-your-host.invalid"
BETTER_AUTH_SECRET="replace-with-independent-random-secret"
# Required only until bootstrap completes.
FIRST_USER_TOKEN="replace-with-independent-bootstrap-secret"
# Optional AI assistance; manual CSV import works without a key.
# Optional fallback; prefer adding the key in Settings → AI.
OPENROUTER_API_KEY=""
# All four R2 values enable private receipt storage.
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
