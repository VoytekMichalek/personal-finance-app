{
  "name": "@finance/api",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:generate": "node ../../scripts/prisma.mjs generate",
    "db:migrate:dev": "node ../../scripts/prisma.mjs migrate dev",
    "db:migrate:deploy": "node ../../scripts/prisma.mjs migrate deploy",
    "integrations:verify": "tsx src/integrations/verify.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@better-auth/core": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.2",
    "@finance/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "multer": "2.5.0",
    "nanostores": "1.5.4",
    "prisma": "6.19.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "tsx": "4.23.15"
  }
}
