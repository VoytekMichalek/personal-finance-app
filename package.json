{
  "name": "personal-finance",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "services:up": "docker compose -f compose.local.yml up -d --wait",
    "services:down": "docker compose -f compose.local.yml down",
    "services:status": "docker compose -f compose.local.yml ps",
    "guardrails": "node scripts/guardrails.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build": "pnpm --filter @finance/shared build && pnpm --filter @finance/api build && pnpm --filter @finance/web build",
    "db:generate": "pnpm --filter @finance/api db:generate",
    "db:migrate:dev": "pnpm --filter @finance/api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @finance/api db:migrate:deploy",
    "ci:prepare": "pnpm --filter @finance/shared build && pnpm db:generate",
    "ci:validate": "node scripts/validate.mjs",
    "ci:release": "node scripts/validate.mjs",
    "ci:smoke": "node scripts/smoke-image.mjs",
    "start:e2e": "node scripts/e2e-server.mjs",
    "start": "pnpm --filter @finance/api start",
    "integrations:verify": "pnpm --filter @finance/api integrations:verify",
    "test:release": "node --test scripts/deploy-dokploy.test.mjs"
  },
  "dependencies": {
    "dotenv": "18.0.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.6.2",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=10.34.6 <11"
  }
}
